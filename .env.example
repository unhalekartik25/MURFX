# .env.example
# SPHEREx Wise-Cube & Blink Explorer configuration defaults

# Server environment
HOST=0.0.0.0
PORT=8000
APP_VERSION=0.1.0
PIPELINE_VERSION=1
CONTACT_EMAIL=team@example.com

# Field of View bounds (arcminutes)
MIN_FOV_ARCMIN=1.0
MAX_FOV_ARCMIN=30.0
DEFAULT_FOV_ARCMIN=6.0

# Frame sequence limits
MAX_FRAMES_HARD=150
DEFAULT_MAX_FRAMES=60

# Grid and image limits
MAX_GRID_PX=512
MAX_UPSAMPLE=4
CUTOUT_MAX_BYTES=30000000
CUTOUT_MAX_PIXELS=4000000

# Timeouts (seconds)
TAP_TIMEOUT_S=90.0
CUTOUT_TIMEOUT_S=90.0
JOB_TIMEOUT_S=600.0

# Concurrency and retries
DOWNLOAD_RETRIES=3
DOWNLOAD_CONCURRENCY=8
JOB_WORKERS=2
MAX_QUEUED_JOBS=10
MAX_ACTIVE_JOBS_PER_IP=2

# Rate limits (requests per minute per client IP)
RATE_GENERAL_PER_MIN=60
RATE_CREATE_PER_MIN=6
RATE_RESOLVE_PER_MIN=20
RATE_FRAMES_PER_MIN=600

# Cache TTLs (seconds) and disk cap
TAP_CACHE_TTL_S=21600
SEQ_CACHE_TTL_S=86400
JOB_TTL_S=3600
CACHE_MAX_BYTES=1000000000
MAX_REQUEST_BODY_BYTES=4096

# Proper-motion propagation target epoch
TARGET_EPOCH=J2026.0

# Directories
CACHE_DIR=./cache
FRONTEND_DIR=frontend

# Reverse proxy and security flags
TRUST_PROXY=0
ENABLE_HSTS=0
ENABLE_DOCS=1
